# Порт сервера
PORT=8787

# CORS: домены фронтенда через запятую (или * для разработки)
ALLOWED_ORIGIN=*

# Опционально: LLM-обогащение (без ключей движок работает на правилах)
# LLM_PROVIDER=gemini | openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
