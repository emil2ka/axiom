# Порт сервера
PORT=8787

# CORS: домены фронтенда через запятую (или * для разработки)
ALLOWED_ORIGIN=*

# Лимит запросов с одного IP в минуту (0 — отключить). /health не лимитируется
RATE_LIMIT_PER_MIN=120

# LOG_SILENT=1 глушит структурный лог — используется e2e-прогоном

# Опционально: LLM-обогащение (без ключей движок работает на правилах)
# LLM_PROVIDER=gemini | openai | openrouter
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
