# URL бэкенда AXIOM (Node/Express). Если не задан — фронтенд работает
# на встроенном движке правил (полный сценарий без сети).
# Пример: https://axiom-backend.up.railway.app
NEXT_PUBLIC_API_URL=

# Optional AI conversation and voice (server-only secrets).
NEXT_PUBLIC_VOICE_ENABLED=0
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
XAI_API_KEY=
XAI_TTS_VOICE=orion
